#include <windows.h>
#include "resource.h"

IDD_CAPTURE_SHORTCUT DIALOGEX 0, 0, 310, 160
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Captura"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_SHORTCUT_LABEL, 13, 14, 284, 13
    EDITTEXT IDC_SHORTCUT_INPUT, 13, 34, 284, 26, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_SHORTCUT_HINT, 13, 69, 284, 33
    CONTROL "", IDC_SHORTCUT_RESET, "SysLink", WS_TABSTOP, 13, 111, 140, 14
    PUSHBUTTON "Cancel", IDCANCEL, 184, 132, 50, 17
    DEFPUSHBUTTON "Save", IDOK, 244, 132, 53, 17
END

1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 1,18,6,0
PRODUCTVERSION 1,18,6,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Captura - screenshots and annotations\0"
   VALUE "ProductName", "Captura\0"
   VALUE "FileVersion", "1.18.6-redaction-preview\0"
   VALUE "OriginalFilename", "Captura.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
